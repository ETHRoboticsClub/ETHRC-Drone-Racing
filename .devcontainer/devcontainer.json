{
  "name": "ERC Aeronautics Dev",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "dev",
  "workspaceFolder": "/ws",
  "remoteUser": "root",
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    "ROS_DOMAIN_ID": "1",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "GZ_SIM_RESOURCE_PATH": "/ws/sim/gazebo/models:/ws/sim/gazebo/worlds",
    "IGN_GAZEBO_RESOURCE_PATH": "/ws/sim/gazebo/models:/ws/sim/gazebo/worlds",
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "XAUTHORITY": "${localEnv:XAUTHORITY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "PULSE_SERVER": "${localEnv:PULSE_SERVER}"
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "twxs.cmake",
        "redhat.vscode-yaml"
      ],
      "settings": {
        // 🧠 Add ROS 2 include path globally for IntelliSense
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/ros/humble/**"
        ]
      }
    }
  }

}