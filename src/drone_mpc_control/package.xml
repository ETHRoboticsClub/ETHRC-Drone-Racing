<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_mpc_control</name>
  <version>2.0.0</version>
  <description>Drone MPC controller for ROS 2 using MAVSDK and ACADOS</description>

  <maintainer email="your_email@example.com">Mattia</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 dependencies (only for node infrastructure) -->
  <depend>rclpy</depend>

  <!-- Python dependencies are managed via pip in the Dockerfile/setup.
    We avoid pinning numpy/scipy to apt packages to prevent ABI conflicts
    with ACADOS (NumPy 1.x vs 2.x). The package's setup.py lists
    pip install requirements. -->
  <exec_depend>python3-pip</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
