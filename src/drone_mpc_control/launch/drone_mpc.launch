<?xml version="1.0"?>
<launch>
    <!-- Argomenti -->
    <arg name="sim" default="true"/>
    <arg name="use_rviz" default="false"/>
    
    <!-- Variabili d'ambiente per ACADOS -->
    <env name="ACADOS_SOURCE_DIR" value="$(env HOME)/acados" />
    <env name="LD_LIBRARY_PATH" value="$(env HOME)/acados/lib:$(env LD_LIBRARY_PATH)" />
    
    <!-- MAVROS -->
    <include file="$(find mavros)/launch/px4.launch">
        <arg name="fcu_url" value="udp://:14540@127.0.0.1:14557"/>
        <arg name="gcs_url" value=""/>
        <arg name="tgt_system" value="1"/>
        <arg name="tgt_component" value="1"/>
    </include>
    
    <!-- Controllore MPC -->
    <node name="drone_mpc_controller" 
          pkg="drone_mpc_control" 
          type="drone_mpc_node.py" 
          output="screen">
        
        <rosparam command="load" file="$(find drone_mpc_control)/config/mpc_params.yaml"/>
        <rosparam command="load" file="$(find drone_mpc_control)/config/drone_params.yaml"/>
    </node>
    
    <!-- RViz (opzionale) -->
    <node if="$(arg use_rviz)" 
          name="rviz" 
          pkg="rviz" 
          type="rviz" 
          args="-d $(find drone_mpc_control)/rviz/drone_view.rviz"/>
    
</launch>