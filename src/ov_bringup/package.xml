<?xml version="1.0"?>
<package format="3">
  <name>ov_bringup</name>
  <version>0.1.0</version>
  <description>Bringup/launch package to run OpenVINS (ov_msckf) in this workspace.</description>

  <maintainer email="devnull@example.com">ERC Aeronautics</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>

  <!-- OpenVINS ROS package provides the node to run (ov_msckf) -->
  <exec_depend>ov_msckf</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>


