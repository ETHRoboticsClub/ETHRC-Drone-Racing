 <customMathEquations>
  <snippet name="Drone Yaw">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm10 = 2 * (x * y + w * z)
dcm00 = w*w + x*x - y*y - z*z

yaw = math.atan2(dcm10, dcm00)* 180/math.pi

return yaw</function>
   <linked_source>/drone_state/data[6]</linked_source>
   <additional_sources>
    <v1>/drone_state/data[7]</v1>
    <v2>/drone_state/data[8]</v2>
    <v3>/drone_state/data[9]</v3>
   </additional_sources>
  </snippet>
  <snippet name="Drone Pitch">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm20 = 2 * (x * z - w * y)

pitch = math.asin(-dcm20)* 180/math.pi

return pitch</function>
   <linked_source>/drone_state/data[6]</linked_source>
   <additional_sources>
    <v1>/drone_state/data[7]</v1>
    <v2>/drone_state/data[8]</v2>
    <v3>/drone_state/data[9]</v3>
   </additional_sources>
  </snippet>
  <snippet name="Drone Roll">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm21 = 2 * (w * x + y * z)
dcm22 = w*w - x*x - y*y + z*z

roll = math.atan2(dcm21, dcm22) * 180/math.pi

return roll</function>
   <linked_source>/drone_state/data[6]</linked_source>
