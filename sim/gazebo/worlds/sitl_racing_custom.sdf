<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sitl_racing_custom">
    <!-- World origin (Pittsburgh area) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.46350</latitude_deg>
      <longitude_deg>-79.51825</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Physics settings -->
    <physics name="realtime" type="ignored">
      <real_time_factor>1</real_time_factor>
      <max_step_size>0.004</max_step_size>
    </physics>

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.2 -0.87</direction>
    </light>

    <!-- Physical floor. A thin box gives stable contact; the visual plane
         keeps the floor visually clean. -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>36 24 0.06</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>36 24</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.30 0.24 1</ambient>
            <diffuse>0.28 0.42 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised launch pad so the drone starts on a simple, isolated contact. -->
    <model name="launch_pad">
      <static>true</static>
      <pose>0 0 0.035 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.07</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.07 0.08 1</ambient>
            <diffuse>0.10 0.11 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low perimeter rails: visual orientation and a gentle out-of-bounds cue. -->
    <model name="north_rail">
      <static>true</static>
      <pose>0 12 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>36 0.12 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>36 0.12 0.25</size></box></geometry><material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_rail">
      <static>true</static>
      <pose>0 -12 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>36 0.12 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>36 0.12 0.25</size></box></geometry><material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_rail">
      <static>true</static>
      <pose>18 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 24 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 24 0.25</size></box></geometry><material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_rail">
      <static>true</static>
      <pose>-18 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 24 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 24 0.25</size></box></geometry><material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Simple gate course. Each gate is four primitive bars to keep collision
         deterministic and cheap. The openings are about 1.8 m wide by 1.5 m tall. -->
    <!-- <model name="gate_1">
      <static>true</static>
      <pose>5 0 1.1 0 0 0</pose>
      <link name="left_bar"><pose>0 0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.8 0.08 0.05 1</ambient><diffuse>0.9 0.12 0.07 1</diffuse></material></visual></link>
      <link name="right_bar"><pose>0 -0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.8 0.08 0.05 1</ambient><diffuse>0.9 0.12 0.07 1</diffuse></material></visual></link>
      <link name="top_bar"><pose>0 0 0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.8 0.08 0.05 1</ambient><diffuse>0.9 0.12 0.07 1</diffuse></material></visual></link>
      <link name="bottom_bar"><pose>0 0 -0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.8 0.08 0.05 1</ambient><diffuse>0.9 0.12 0.07 1</diffuse></material></visual></link>
    </model>

    <model name="gate_2">
      <static>true</static>
      <pose>10 4 1.1 0 0 0.65</pose>
      <link name="left_bar"><pose>0 0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.05 0.28 0.85 1</ambient><diffuse>0.08 0.38 0.95 1</diffuse></material></visual></link>
      <link name="right_bar"><pose>0 -0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.05 0.28 0.85 1</ambient><diffuse>0.08 0.38 0.95 1</diffuse></material></visual></link>
      <link name="top_bar"><pose>0 0 0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.05 0.28 0.85 1</ambient><diffuse>0.08 0.38 0.95 1</diffuse></material></visual></link>
      <link name="bottom_bar"><pose>0 0 -0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.05 0.28 0.85 1</ambient><diffuse>0.08 0.38 0.95 1</diffuse></material></visual></link>
    </model>

    <model name="gate_3">
      <static>true</static>
      <pose>10 -4 1.1 0 0 -0.65</pose>
      <link name="left_bar"><pose>0 0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.95 0.74 0.08 1</diffuse></material></visual></link>
      <link name="right_bar"><pose>0 -0.95 0 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 0.12 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.12 2.2</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.95 0.74 0.08 1</diffuse></material></visual></link>
      <link name="top_bar"><pose>0 0 0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.95 0.74 0.08 1</diffuse></material></visual></link>
      <link name="bottom_bar"><pose>0 0 -0.8 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.02 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.02 0.12</size></box></geometry><material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.95 0.74 0.08 1</diffuse></material></visual></link>
    </model> -->

   <include>
      <uri>model://race_gate_ethrc</uri>
      <name>gate_custom</name>
      <pose>5 0 1.0 0 0 0</pose>
   </include>
    <!-- Include the drone_sitl model. Spawn above the launch pad so it does
         not intersect the contact surface at t=0. -->
    <include>
      <uri>model://drone_sitl</uri>
      <name>drone</name>
      <pose>0 0 0.5 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5 -4 3 0 0.35 0.75</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
