<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="drone_sitl">

    <static>false</static>

    <!-- ===================================================== -->
    <!--                    BASE LINK                         -->
    <!-- ===================================================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <!-- From anemos_drone/raw/drone_acc_mass_description/urdf/drone_acc_mass.urdf. -->
        <pose>0.004839178109627602 0.0034084153156952045 0.00927557259352703 0 0 0</pose>
        <mass>0.8351086449771665</mass>
        <inertia>
          <ixx>0.002158</ixx>
          <iyy>0.002919</iyy>
          <izz>0.002743</izz>
          <ixy>0.000001</ixy>
          <ixz>-0.000085</ixz>
          <iyz>-0.000043</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://anemos_drone/raw/drone_acc_mass_description/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <collision name="base_collision">
        <!-- Keep collision simple; the raw STL is very detailed and hurts RTF. -->
        <pose>0.003157 0.002282 0.017908 0 0 0</pose>
        <geometry>
          <box>
            <size>0.21 0.18 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ===================================================== -->
      <!--                        SENSORS                       -->
      <!-- ===================================================== -->

      <!-- IMU (MPU6000 noise approximation) -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <topic>/drone/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0014</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.03</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.03</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.03</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Magnetometer -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <!-- Barometer (BMP280) -->
      <sensor name="barometer_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>1.3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- GPS (Enabled, needed for Offboard / ALTCTL / POSCTL in SITL) -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><stddev>0.7</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.7</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><stddev>0.1</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><stddev>0.1</stddev></noise></vertical>
          </velocity_sensing>
        </gps>
      </sensor>

      <!-- ===================================================== -->
      <!--                      CAMERA                          -->
      <!-- ===================================================== -->
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0.12 0.0 0.04 0 0 0</pose>
        <camera>
          <horizontal_fov>2.705</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.01</near><far>100</far></clip>
          <lens>
            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>
          </lens>
        </camera>
        <topic>/drone/camera/image</topic>
      </sensor>

    </link>

    <!-- Prop links are visual-only for SITL parity: near-zero inertial values,
         no collisions, and propulsion remains direct Betaflight motor wrenches. -->
    <link name="FL_5_inch_CW_prop_1_1_1">
      <pose relative_to="base_link">0.088628 -0.068017 0.040514 0 0 0</pose>
      <inertial>
        <pose>-0.000000495499 0.000001172823 0.004922947495 0 0 0</pose>
        <mass>0.000000001</mass>
        <inertia>
          <ixx>0.000000000000001</ixx>
          <iyy>0.000000000000001</iyy>
          <izz>0.000000000000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="front_left_prop_visual">
        <pose>-0.088628 0.068017 -0.040514 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://anemos_drone/raw/drone_acc_mass_description/meshes/FL_5_inch_CW_prop_1_1_1.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="FR_5_inch_CCW_prop_1_1_1">
      <pose relative_to="base_link">0.088431 0.072039 0.040514 0 0 0</pose>
      <inertial>
        <pose>0.000002120847 -0.000000100948 0.004922948264 0 0 0</pose>
        <mass>0.000000001</mass>
        <inertia>
          <ixx>0.000000000000001</ixx>
          <iyy>0.000000000000001</iyy>
          <izz>0.000000000000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="front_right_prop_visual">
        <pose>-0.088431 -0.072039 -0.040514 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://anemos_drone/raw/drone_acc_mass_description/meshes/FR_5_inch_CCW_prop_1_1_1.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="BL_5_inch_CCW_prop_1_1_1">
      <pose relative_to="base_link">-0.082176 -0.068017 0.040514 0 0 0</pose>
      <inertial>
        <pose>0.000001689673 -0.000000463099 0.004922948264 0 0 0</pose>
        <mass>0.000000001</mass>
        <inertia>
          <ixx>0.000000000000001</ixx>
          <iyy>0.000000000000001</iyy>
          <izz>0.000000000000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="back_left_prop_visual">
        <pose>0.082176 0.068017 -0.040514 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://anemos_drone/raw/drone_acc_mass_description/meshes/BL_5_inch_CCW_prop_1_1_1.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="BR_5_inch_CW_prop_1_1_1">
      <pose relative_to="base_link">-0.081841 0.071798 0.040514 0 0 0</pose>
      <inertial>
        <pose>0.000000057190 0.000001267331 0.004922947501 0 0 0</pose>
        <mass>0.000000001</mass>
        <inertia>
          <ixx>0.000000000000001</ixx>
          <iyy>0.000000000000001</iyy>
          <izz>0.000000000000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="back_right_prop_visual">
        <pose>0.081841 -0.071798 -0.040514 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://anemos_drone/raw/drone_acc_mass_description/meshes/BR_5_inch_CW_prop_1_1_1.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="Revolute_15" type="revolute">
      <parent>base_link</parent>
      <child>FL_5_inch_CW_prop_1_1_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="Revolute_16" type="revolute">
      <parent>base_link</parent>
      <child>FR_5_inch_CCW_prop_1_1_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="Revolute_17" type="revolute">
      <parent>base_link</parent>
      <child>BL_5_inch_CCW_prop_1_1_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="Revolute_18" type="revolute">
      <parent>base_link</parent>
      <child>BR_5_inch_CW_prop_1_1_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ===================================================== -->
    <!--                BETAFLIGHT SITL PLUGIN                 -->
    <!-- ===================================================== -->
    <plugin name="gz::sim::systems::EthrcBetaflightSITLPlugin" filename="EthrcBetaflightSITLPlugin">
      <imuName>imu_sensor</imuName>
      <bindAddress>127.0.0.1</bindAddress>
      <betaflightAddress>127.0.0.1</betaflightAddress>
      <motorInputPort>9002</motorInputPort>
      <stateOutputPort>9003</stateOutputPort>
      <connectionTimeoutMaxCount>50</connectionTimeoutMaxCount>
      <!-- 4:1 thrust-to-weight for the raw URDF mass: 4 * 0.8351086449771665 * 9.80665. -->
      <maxTotalThrust>32.7584728</maxTotalThrust>
      <!-- Match Betaflight ACTUAL yaw rates (~500 deg/s full stick) without snap-spinning the Gazebo body. -->
      <yawTorqueCoefficient>0.00125</yawTorqueCoefficient>
      <yawDampingCoefficient>0.006</yawDampingCoefficient>
      <maxRpm>30000</maxRpm>
      <visualMaxRpm>3600</visualMaxRpm>
      <resetPose>0 0 0.5 0 0 0</resetPose>
      <maxWorldPosition>30</maxWorldPosition>
      <minWorldAltitude>-0.5</minWorldAltitude>
      <maxWorldAltitude>20</maxWorldAltitude>
      <maxLinearSpeed>35</maxLinearSpeed>
      <maxAngularSpeed>80</maxAngularSpeed>

      <!-- BF Motor 1: Back Right -->
      <rotor id="0">
        <jointName>Revolute_18</jointName>
        <position>-0.081108 0.086485 0.044629</position>
        <turningDirection>cw</turningDirection>
      </rotor>

      <!-- BF Motor 2: Front Right -->
      <rotor id="1">
        <jointName>Revolute_16</jointName>
        <position>0.099477 0.067468 0.044629</position>
        <turningDirection>ccw</turningDirection>
      </rotor>

      <!-- BF Motor 3: Back Left -->
      <rotor id="2">
        <jointName>Revolute_17</jointName>
        <position>-0.073632 -0.075213 0.044629</position>
        <turningDirection>ccw</turningDirection>
      </rotor>

      <!-- BF Motor 4: Front Left -->
      <rotor id="3">
        <jointName>Revolute_15</jointName>
        <position>0.086702 -0.054547 0.044629</position>
        <turningDirection>cw</turningDirection>
      </rotor>
    </plugin>

    <!-- ===================================================== -->
    <!--              ODOMETRY PUBLISHER PLUGIN                -->
    <!-- ===================================================== -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/drone/odometry</odom_topic>
    </plugin>

  </model>
</sdf>
