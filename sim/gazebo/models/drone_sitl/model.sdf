<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="drone_sitl">

    <static>false</static>

    <!-- ===================================================== -->
    <!--                    BASE LINK                         -->
    <!-- ===================================================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>1.3116</mass>
        <inertia>
          <ixx>0.003708</ixx>
          <iyy>0.002511</iyy>
          <izz>0.004013</izz>
          <ixy>0</ixy>
          <ixz>-2e-06</ixz>
          <iyz>-1.7e-05</iyz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://drone_urdf/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_collision">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://drone_urdf/meshes/base_link.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <!-- ===================================================== -->
      <!--                        SENSORS                       -->
      <!-- ===================================================== -->

      <!-- IMU (MPU6000 noise approximation) -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <topic>/drone/imu</topic>
        <imu>
          <angular_velocity>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0014</stddev>
            </noise>
          </angular_velocity>
          <linear_acceleration>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.03</stddev>
            </noise>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Magnetometer -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <!-- Barometer (BMP280) -->
      <sensor name="barometer_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>1.3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- GPS (Enabled, needed for Offboard / ALTCTL / POSCTL in SITL) -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <navsat>
          <position>
            <noise type="gaussian"><stddev>0.7</stddev></noise>
          </position>
          <velocity>
            <noise type="gaussian"><stddev>0.1</stddev></noise>
          </velocity>
        </navsat>
      </sensor>

      <!-- ===================================================== -->
      <!--                      CAMERA                          -->
      <!-- ===================================================== -->
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <pose>0.05 0.0 0.03 0 0 0</pose>
        <camera>
          <horizontal_fov>2.705</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.01</near><far>100</far></clip>
          <lens>
            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>
          </lens>
        </camera>
        <topic>/drone/camera/image</topic>
      </sensor>

    </link>

    <!-- ===================================================== -->
    <!--                      ROTOR LINKS                      -->
    <!-- ===================================================== -->
    <link name="rotor_0"><pose>0.05 0.05 0.02 0 0 0</pose><inertial><mass>0.012</mass><inertia><ixx>9.75e-06</ixx><iyy>0.000167</iyy><izz>0.000168</izz></inertia></inertial><collision name="rotor_0_collision"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry></collision><visual name="rotor_0_visual"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry><material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material></visual></link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_1"><pose>-0.05 0.05 0.02 0 0 0</pose><inertial><mass>0.012</mass><inertia><ixx>9.75e-06</ixx><iyy>0.000167</iyy><izz>0.000168</izz></inertia></inertial><collision name="rotor_1_collision"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry></collision><visual name="rotor_1_visual"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_2"><pose>-0.05 -0.05 0.02 0 0 0</pose><inertial><mass>0.012</mass><inertia><ixx>9.75e-06</ixx><iyy>0.000167</iyy><izz>0.000168</izz></inertia></inertial><collision name="rotor_2_collision"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry></collision><visual name="rotor_2_visual"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry><material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material></visual></link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_3"><pose>0.05 -0.05 0.02 0 0 0</pose><inertial><mass>0.012</mass><inertia><ixx>9.75e-06</ixx><iyy>0.000167</iyy><izz>0.000168</izz></inertia></inertial><collision name="rotor_3_collision"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry></collision><visual name="rotor_3_visual"><geometry><cylinder><length>0.005</length><radius>0.06</radius></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <!-- ===================================================== -->
    <!--                 LIFT/DRAG PLUGINS                     -->
    <!-- ===================================================== -->
    <!-- rotor_0 (Front Left, CCW) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>0.045 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>-0.045 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>

    <!-- rotor_1 (Back Left, CW) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>0.045 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>-0.045 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>

    <!-- rotor_2 (Back Right, CCW) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>0.045 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>-0.045 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>

    <!-- rotor_3 (Front Right, CW) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>0.045 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_3</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.025</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <area>0.15</area>
      <air_density>1.2041</air_density>
      <cp>-0.045 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_3</link_name>
    </plugin>

    <!-- ===================================================== -->
    <!--                BETAFLIGHT SITL PLUGIN                 -->
    <!-- ===================================================== -->
    <plugin name="gz::sim::systems::BetaflightPlugin" filename="BetaflightPlugin">
      <imuName>imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      
      <!-- BF Motor 1: Back Right (rotor_2, CCW) -->
      <rotor id="0">
        <vel_p_gain>0.01</vel_p_gain>
        <vel_i_gain>0</vel_i_gain>
        <vel_d_gain>0</vel_d_gain>
        <vel_i_max>0</vel_i_max>
        <vel_i_min>0</vel_i_min>
        <vel_cmd_max>4000.0</vel_cmd_max>
        <vel_cmd_min>-4000.0</vel_cmd_min>
        <jointName>rotor_2_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </rotor>

      <!-- BF Motor 2: Front Right (rotor_3, CW) -->
      <rotor id="1">
        <vel_p_gain>0.01</vel_p_gain>
        <vel_i_gain>0</vel_i_gain>
        <vel_d_gain>0</vel_d_gain>
        <vel_i_max>0</vel_i_max>
        <vel_i_min>0</vel_i_min>
        <vel_cmd_max>4000.0</vel_cmd_max>
        <vel_cmd_min>-4000.0</vel_cmd_min>
        <jointName>rotor_3_joint</jointName>
        <turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </rotor>

      <!-- BF Motor 3: Back Left (rotor_1, CW) -->
      <rotor id="2">
        <vel_p_gain>0.01</vel_p_gain>
        <vel_i_gain>0</vel_i_gain>
        <vel_d_gain>0</vel_d_gain>
        <vel_i_max>0</vel_i_max>
        <vel_i_min>0</vel_i_min>
        <vel_cmd_max>4000.0</vel_cmd_max>
        <vel_cmd_min>-4000.0</vel_cmd_min>
        <jointName>rotor_1_joint</jointName>
        <turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </rotor>

      <!-- BF Motor 4: Front Left (rotor_0, CCW) -->
      <rotor id="3">
        <vel_p_gain>0.01</vel_p_gain>
        <vel_i_gain>0</vel_i_gain>
        <vel_d_gain>0</vel_d_gain>
        <vel_i_max>0</vel_i_max>
        <vel_i_min>0</vel_i_min>
        <vel_cmd_max>4000.0</vel_cmd_max>
        <vel_cmd_min>-4000.0</vel_cmd_min>
        <jointName>rotor_0_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </rotor>
    </plugin>

    <!-- ===================================================== -->
    <!--              ODOMETRY PUBLISHER PLUGIN                -->
    <!-- ===================================================== -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/drone/odometry</odom_topic>
    </plugin>

  </model>
</sdf>
