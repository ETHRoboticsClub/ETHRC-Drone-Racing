# =============================================================================
# Dockerfile for Isaac Sim + Pegasus + PX4 SITL + ROS 2 MPC
#
# Uses NVIDIA Isaac Sim container as base, adds PX4 + Pegasus + MPC stack.
# Requires: NVIDIA Container Toolkit (nvidia-docker2)
#
# Build:
#   docker compose -f docker-compose.isaacsim.yaml build
# Run:
#   docker compose -f docker-compose.isaacsim.yaml up -d
# =============================================================================
ARG ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim:4.2.0
FROM ${ISAACSIM_BASE_IMAGE} AS isaacsim-base

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# --- System deps ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential ninja-build wget curl \
    python3-pip python3-dev swig gfortran \
    libblas-dev liblapack-dev libopenblas-dev liblapacke-dev \
    && rm -rf /var/lib/apt/lists/*

# --- ROS 2 Humble (for MPC controller + px4_msgs) ---
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ros-base \
        ros-humble-rmw-cyclonedds-cpp \
        python3-colcon-common-extensions python3-rosdep python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# --- MAVSDK Python ---
RUN pip3 install --no-cache-dir mavsdk casadi numpy scipy

# --- ACADOS ---
RUN git clone https://github.com/acados/acados.git /opt/acados && \
    cd /opt/acados && git submodule update --recursive --init && \
    mkdir -p build && cd build && \
    cmake -DACADOS_SHARED_LIBS=ON -DACADOS_WITH_QPOASES=ON .. && \
    make install -j$(nproc)
RUN mkdir -p /opt/acados/bin && \
    wget -q https://github.com/acados/tera_renderer/releases/download/v0.2.0/t_renderer-v0.2.0-linux-amd64 \
        -O /opt/acados/bin/t_renderer && \
    chmod +x /opt/acados/bin/t_renderer
RUN pip3 install --no-cache-dir -e /opt/acados/interfaces/acados_template
ENV TERA_PATH=/opt/acados/bin/t_renderer
ENV LD_LIBRARY_PATH=/opt/acados/lib:${LD_LIBRARY_PATH}
ENV ACADOS_SOURCE_DIR=/opt/acados

# --- PegasusSimulator ---
# Pegasus versioning is 1:1 with Isaac Sim (v4.2.0 for isaac-sim:4.2.0).
# The main branch targets Isaac Sim 5.x and will NOT work with 4.x.
ENV ISAACSIM_PATH=/isaac-sim
RUN git clone --branch v4.2.0 https://github.com/PegasusSimulator/PegasusSimulator.git /opt/PegasusSimulator && \
    pip3 install --no-cache-dir -e /opt/PegasusSimulator/extensions/pegasus.simulator

# --- User setup ---
# The isaac-sim base image already has user "ubuntu" at UID 1000.
# Rename it to drone_dev to match our convention.
ARG USERNAME=drone_dev
RUN existing_user=$(getent passwd 1000 | cut -d: -f1) && \
    if [ "$existing_user" != "$USERNAME" ] && [ -n "$existing_user" ]; then \
        usermod -l $USERNAME -d /home/$USERNAME -m $existing_user && \
        groupmod -n $USERNAME $existing_user; \
    elif [ -z "$existing_user" ]; then \
        groupadd --gid 1000 $USERNAME && \
        useradd -s /bin/bash --uid 1000 --gid 1000 -m $USERNAME; \
    fi && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME

ENV WORKSPACE=/home/${USERNAME}/ros_ws
WORKDIR ${WORKSPACE}

# --- Shell config ---
RUN echo "source /opt/ros/humble/setup.bash" >> /home/${USERNAME}/.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> /home/${USERNAME}/.bashrc && \
    echo "if [ -f ${WORKSPACE}/install/setup.bash ]; then source ${WORKSPACE}/install/setup.bash; fi" >> /home/${USERNAME}/.bashrc

USER ${USERNAME}
CMD ["/bin/bash"]
